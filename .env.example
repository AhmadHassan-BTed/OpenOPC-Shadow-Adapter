# ─────────────────────────────────────────────────────────────────────────────
# OpenOPC Shadow Adapter — Environment Configuration Template
# Copy this file to .env and configure secret keys and paths for your setup.
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT Authentication (REQUIRED in production) ──────────────────────────────
# Replace with a strong random secret key (e.g. openssl rand -hex 32)
SHADOW_JWT_SECRET=change-me-to-a-secure-random-secret-key-32-chars-minimum
SHADOW_JWT_ALGORITHM=HS256
SHADOW_JWT_EXPIRE_HOURS=24

# ── Database Paths ───────────────────────────────────────────────────────────
# Path to the isolated SQLite database for parked shadow tasks
SHADOW_DB_PATH=./shadow_tasks.db

# Path to OpenOPC's SQLite store.db for resume WAL callbacks
SHADOW_OPC_STORE_PATH=.opc/projects/default/store.db

# ── File Upload Security & Guardrail Limits ──────────────────────────────────
# Storage directory for contractor uploaded attachments
SHADOW_UPLOAD_DIR=./shadow_uploads

# Maximum number of attachment files allowed per submission (default: 5)
SHADOW_MAX_FILES_PER_SUBMISSION=5

# Maximum size in MB per individual uploaded file (default: 10)
SHADOW_MAX_FILE_SIZE_MB=10

# Maximum total submission payload size in MB (default: 50)
SHADOW_MAX_TOTAL_UPLOAD_SIZE_MB=50

# Comma-separated list of allowed file extensions
SHADOW_ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.txt,.md,.png,.jpg,.jpeg,.zip,.tar.gz

# ── API Server Configuration ──────────────────────────────────────────────────
SHADOW_API_PORT=8800
SHADOW_API_HOST=0.0.0.0
SHADOW_LOG_LEVEL=INFO
